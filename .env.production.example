NODE_ENV=production
PORT=3000

GEMINI_API_KEY=replace-with-your-key

# docker-compose overrides this to http://chroma:8000
CHROMA_URL=http://chroma:8000

STORAGE_DIR=/app/storage/documents
MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=info

# ── Caddy (used for Compose variable substitution) ──────────────────
# Bare domain or host; Caddy obtains TLS certificates automatically.
APP_DOMAIN=docs.example.com
APP_BASIC_AUTH_USER=admin

# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the hash in single quotes so Compose does not interpolate the "$".
APP_BASIC_AUTH_HASH='$2a$14$replace-with-the-generated-hash'
