NODE_ENV=production
PORT=3000

GEMINI_API_KEY=replace-with-your-key

CHROMA_API_KEY=replace-with-your-chroma-cloud-key
CHROMA_TENANT=replace-with-your-tenant
CHROMA_DATABASE=replace-with-your-database
# CHROMA_HOST=europe-west1.gcp.trychroma.com

STORAGE_DIR=/tmp/ask-my-docs
MAX_UPLOAD_BYTES=4194304
LOG_LEVEL=info

APP_AUTH_USER=replace-with-a-username
APP_AUTH_PASSWORD=replace-with-a-strong-password
